{
  "name": "@peaq-network/msf",
  "version": "0.0.0",
  "description": "Peaq Network Machine Station SDK for smart contract interactions and role-based operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm run build && npm pack",
    "test": "node --expose-gc ./node_modules/.bin/jest --runInBand",
    "test:verbose": "node --expose-gc ./node_modules/.bin/jest --runInBand --verbose"
  },
  "keywords": [
    "peaq",
    "machine-station",
    "smart-contracts",
    "blockchain",
    "evm",
    "ethereum",
    "sdk",
    "typescript"
  ],
  "author": "Peaq Network",
  "license": "MIT",
  "dependencies": {
    "ethers": "^6.14.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
