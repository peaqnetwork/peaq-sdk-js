{
  "name": "@peaq-network/msf",
  "version": "1.2.1-1",
  "description": "Machine Station SDK for MSF smart contract interactions on the peaq network.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -b",
    "clean": "rimraf dist",
    "prepack": "npm run build"
  },
  "keywords": [
    "peaq",
    "machine-station",
    "smart-contracts",
    "account-abstraction",
    "gas-funding",
    "blockchain",
    "evm",
    "ethereum",
    "sdk",
    "typescript"
  ],
  "author": "Peaq Network",
  "license": "MIT",
  "peerDependencies": {
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "ethers": "^6.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
