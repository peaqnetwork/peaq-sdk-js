{
  "name": "@peaq-network/sdk",
  "version": "1.0.1-5",
  "description": "TypeScript/JavaScript SDK for DID, Storage, and RBAC operations on the peaq network.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo node_modules/.cache/tsbuild",
    "prepack": "npm run build"
  },
  "keywords": [
    "peaq",
    "blockchain",
    "did",
    "storage",
    "rbac",
    "sdk",
    "typescript"
  ],
  "author": "Peaq Network",
  "license": "MIT",
  "dependencies": {
    "bs58": "^6.0.0",
    "peaq-did-proto-js": "^2.1.0",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "@polkadot/api": "^16.4.7",
    "@polkadot/keyring": "^13.5.6",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@polkadot/wasm-crypto": "^7.5.1",
    "@streamr/sdk": "^103.0.0",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@polkadot/api": "^16.4.7",
    "@polkadot/keyring": "^13.5.6",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@polkadot/wasm-crypto": "^7.5.1",
    "ethers": "^6.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
