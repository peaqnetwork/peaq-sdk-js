{
  "name": "@peaq-network/sdk",
  "version": "1.0.1-3",
  "description": "TypeScript/JavaScript SDK for DID, Storage, and RBAC operations on the peaq network.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/esm/index.d.ts" }
},
  "files": ["dist/**/*", "README.md", "LICENSE"],
  "scripts": {
    "build": "npm run clean && tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -b",
    "clean": "rimraf dist",
    "prepack": "npm run build"
  },
  "keywords": [
    "peaq",
    "blockchain",
    "did",
    "storage",
    "rbac",
    "sdk",
    "typescript"
  ],
  "author": "Peaq Network",
  "license": "MIT",
  "dependencies": {
    "bs58": "^6.0.0",
    "peaq-did-proto-js": "^2.1.0",
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "ethers": "^6.15.0",
    "@polkadot/api": "^16.4.7",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@polkadot/keyring": "^13.5.6",
    "@polkadot/wasm-crypto": "^7.5.1"
  },
  "devDependencies": {
    "ethers": "^6.15.0",
    "@polkadot/api": "^16.4.7",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "@polkadot/keyring": "^13.5.6",
    "@polkadot/wasm-crypto": "^7.5.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}