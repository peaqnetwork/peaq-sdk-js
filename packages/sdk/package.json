{
  "name": "@peaq-network/sdk",
  "version": "1.0.1-3",
  "description": "Peaq Network TypeScript SDK for DID, Storage, and RBAC operations",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "peaq-did-proto-js.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "pack": "npm run build && npm pack",
    "test": "node --expose-gc ./node_modules/.bin/jest --runInBand",
    "test:verbose": "node --expose-gc ./node_modules/.bin/jest --runInBand --verbose",
    "test:debug": "node --expose-gc ./node_modules/.bin/jest --runInBand --detectOpenHandles --logHeapUsage --verbose",
    "test:memory": "node --expose-gc --max-old-space-size=4096 ./node_modules/.bin/jest --runInBand --logHeapUsage",
    "test:single": "node --expose-gc ./node_modules/.bin/jest --runInBand --testTimeout=300000"
  },
  "keywords": [
    "peaq",
    "blockchain",
    "did",
    "storage",
    "rbac",
    "sdk",
    "typescript"
  ],
  "author": "Peaq Network",
  "license": "MIT",
  "dependencies": {
    "@polkadot/api": "16.2.1",
    "bs58": "^6.0.0",
    "ethers": "^6.14.4",
    "peaq-did-proto-js": "^2.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.1",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
