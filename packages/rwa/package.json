{
  "name": "@peaq-network/rwa",
  "version": "0.0.1",
  "description": "TypeScript/JavaScript SDK for RWA on the peaq network.",
  "author": "peaq network",
  "keywords": [
    "peaq",
    "blockchain",
    "rwa",
    "sdk",
    "typescript",
    "javascript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist .tsbuildinfo",
    "codegen": "typechain --target=ethers-v6 --out-dir src/typechain \"src/abis/*.json\"",
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "prebuild": "npm run codegen",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier -w .",
    "prepublishOnly": "npm run clean && npm run build && npm run test && npm run lint"
  },
  "peerDependencies": {
    "ethers": "^6.15.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": false
    }
  },
  "devDependencies": {
    "@typechain/ethers-v6": "^0.5.1",
    "@types/node": "^24.9.1",
    "eslint": "^9.11.0",
    "ethers": "^6.15.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsup": "^8.1.0",
    "typechain": "^8.3.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
