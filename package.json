{
  "name": "peaq-network",
  "version": "1.0.0",
  "description": "peaq network SDK Monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "pack:sdk": "npm run pack --workspace=@peaqnetwork/sdk",
    "pack:machine-station": "npm run pack --workspace=@peaqnetwork/machine-station",
    "pack:all": "npm run pack --workspaces"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
