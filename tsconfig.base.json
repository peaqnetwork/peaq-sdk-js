{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@peaq-network/sdk/*": ["packages/sdk/src/*"],
      "@peaq-network/msf/*": ["packages/msf/src/*"],
      // "@peaq-network/rwa/*": ["packages/rwa/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts", "**/*.spec.ts"]
}